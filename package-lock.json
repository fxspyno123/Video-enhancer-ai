* { -webkit-tap-highlight-color: transparent; }

.v3-font-headline-1 { font-family: "Inter Tight", sans-serif; font-optical-sizing: auto; font-size: 24px; font-weight: 600; line-height: 32px; }

.v3-font-headline-2 { font-family: Inter, sans-serif; font-optical-sizing: auto; font-size: 16px; font-weight: 500; line-height: 24px; }

.v3-font-label { font-family: Inter, sans-serif; font-optical-sizing: auto; font-size: 12px; font-weight: 400; line-height: 18px; }

.v3-font-label-thin { font-family: Inter, sans-serif; font-optical-sizing: auto; font-size: 12px; font-weight: 400; line-height: 16px; }

.v3-font-body { font-family: Inter, sans-serif; font-optical-sizing: auto; font-size: 14px; font-weight: 400; line-height: 21px; }

.v3-font-body-medium { font-family: Inter, sans-serif; font-optical-sizing: auto; font-size: 14px; font-weight: 500; line-height: 21px; }

* { box-sizing: border-box; }

p { font-size: 13px; line-height: 20px; }

html { font-family: Inter, sans-serif; font-optical-sizing: auto; font-size: 14px; font-weight: 400; line-height: 21px; -webkit-font-smoothing: antialiased; }

h1, h2, h3, h4, h5, h6 { margin: 0px; }

.dark-theme, .light-theme { scrollbar-color: var(--color-v3-outline) transparent; }

.makersuite-layout { display: flex; overflow: hidden; flex: 1 0 0%; position: relative; }

.makersuite-layout .layout-wrapper { display: flex; flex-direction: column; height: 100%; width: 100%; overflow: hidden; }

.makersuite-layout .layout-main { flex: 1 0 0%; min-height: 0px; outline: none; overflow-x: hidden; width: 100%; }

body, body.dark-theme, body.light-theme, html { font-size: 14px; font-weight: 400; line-height: 20px; font-family: Inter, sans-serif; letter-spacing: normal; --mat-icon-button-touch-target-display: none; }

body .mat-mdc-icon-button.mat-mdc-button-base, body.dark-theme .mat-mdc-icon-button.mat-mdc-button-base, body.light-theme .mat-mdc-icon-button.mat-mdc-button-base, html .mat-mdc-icon-button.mat-mdc-button-base { --mdc-icon-button-state-layer-size: 40px; --mat-icon-button-state-layer-size: 40px; width: var(--mat-icon-button-state-layer-size); height: var(--mat-icon-button-state-layer-size); padding: 8px; }

body, html { height: 100%; margin: 0px; overflow: hidden; }

app-root { display: flex; flex-direction: column; flex-grow: 1; min-height: 0px; }

body { background-color: var(--color-v3-surface-container); color: var(--color-v3-text); display: flex; flex-direction: column; }

.light-theme ms-edit-function-declarations-dialog .entry-description .mat-mdc-form-field-subscript-wrapper, .light-theme ms-edit-function-declarations-dialog .entry-name .mat-mdc-form-field-subscript-wrapper { display: none; }

.light-theme ms-edit-function-declarations-dialog .entry-description input, .light-theme ms-edit-function-declarations-dialog .entry-name input { vertical-align: middle; }

.light-theme a { color: var(--color-v3-text-link); font-weight: 500; text-decoration: none; cursor: pointer; }

.light-theme b { font-weight: 500; }

.light-theme button { font-size: 14px; font-weight: 500; line-height: 20px; font-family: Inter, sans-serif; letter-spacing: normal; }

.dark-theme ms-edit-function-declarations-dialog .entry-description .mat-mdc-form-field-subscript-wrapper, .dark-theme ms-edit-function-declarations-dialog .entry-name .mat-mdc-form-field-subscript-wrapper { display: none; }

.dark-theme ms-edit-function-declarations-dialog .entry-description input, .dark-theme ms-edit-function-declarations-dialog .entry-name input { vertical-align: middle; }

.dark-theme a { color: var(--color-v3-text-link); font-weight: 500; text-decoration: none; cursor: pointer; }

.dark-theme b { font-weight: 500; }

.dark-theme button { font-size: 14px; font-weight: 500; line-height: 20px; font-family: Inter, sans-serif; letter-spacing: normal; }

.page-content-wrapper { align-items: center; display: flex; flex-direction: column; padding-left: 24px; padding-right: 24px; overflow: hidden auto; height: 100%; background-color: var(--color-v3-surface); }

@media screen and (max-width: 600px) {
  .page-content-wrapper { padding-left: 16px; padding-right: 16px; }
}

.page-content-wrapper:first-of-type { padding-top: 48px; }

.page-content-wrapper.no-scroll { overflow-y: hidden; }

.page-content-wrapper.no-scroll .page-content-inner-wrapper { max-height: 100%; }

.page-content-wrapper.inner-padding { padding-left: 0px; padding-right: 0px; padding-top: 0px; }

.page-content-wrapper.inner-padding .padding-wrapper { display: flex; justify-content: center; width: 100%; }

@media screen and (max-width: 768px) {
  .page-content-wrapper { margin-right: 0px; }
}

.page-content-wrapper:last-of-type { padding-bottom: 24px; }

.page-content-inner-wrapper { width: 100%; max-width: 960px; display: flex; flex-direction: column; flex-grow: 1; }

.prompt-page { display: flex; height: 100%; }

.prompt-page .page-content-inner-wrapper { max-width: unset; }

.no-scroll-x { overflow-x: hidden; }

.light-theme input { font-family: Inter, sans-serif; font-optical-sizing: auto; font-size: 14px; font-weight: 400; line-height: 21px; background: inherit; color: inherit; }

.dark-theme input { font-family: Inter, sans-serif; font-optical-sizing: auto; font-size: 14px; font-weight: 400; line-height: 21px; background: inherit; color: inherit; }

.light-theme textarea:not([ms-input]) { font-family: Inter, sans-serif; font-optical-sizing: auto; font-size: 14px; font-weight: 400; line-height: 21px; background: inherit; border: none; color: inherit; }

.dark-theme textarea:not([ms-input]) { font-family: Inter, sans-serif; font-optical-sizing: auto; font-size: 14px; font-weight: 400; line-height: 21px; background: inherit; border: none; color: inherit; }

.light-theme .flex-wrapper { display: flex; gap: 12px; }

.light-theme .flex-wrapper.space-between { justify-content: space-between; }

.light-theme .flex-wrapper.align-center { align-items: center; }

.light-theme .flex-wrapper.justify-center { justify-content: center; }

@media screen and (max-width: 600px) {
  .light-theme .flex-wrapper { flex-direction: column; }
}

.dark-theme .flex-wrapper { display: flex; gap: 12px; }

.dark-theme .flex-wrapper.space-between { justify-content: space-between; }

.dark-theme .flex-wrapper.align-center { align-items: center; }

.dark-theme .flex-wrapper.justify-center { justify-content: center; }

@media screen and (max-width: 600px) {
  .dark-theme .flex-wrapper { flex-direction: column; }
}

.light-theme .grid-wrapper { width: max-content; max-width: 100%; display: grid; gap: 20px; }

.light-theme .grid-wrapper.col-2 { grid-template-columns: repeat(2, 1fr); }

.light-theme .grid-wrapper.col-3 { grid-template-columns: repeat(3, 1fr); }

@media screen and (max-width: 600px) {
  .light-theme .grid-wrapper.col-2, .light-theme .grid-wrapper.col-3 { grid-template-columns: repeat(1, 1fr); }
}

.dark-theme .grid-wrapper { width: max-content; max-width: 100%; display: grid; gap: 20px; }

.dark-theme .grid-wrapper.col-2 { grid-template-columns: repeat(2, 1fr); }

.dark-theme .grid-wrapper.col-3 { grid-template-columns: repeat(3, 1fr); }

@media screen and (max-width: 600px) {
  .dark-theme .grid-wrapper.col-2, .dark-theme .grid-wrapper.col-3 { grid-template-columns: repeat(1, 1fr); }
}

.dark-theme .fill-space, .light-theme .fill-space { flex: 1 1 0%; }

@media screen and (max-width: 600px) {
  .light-theme .viewport-small-hidden { display: none; }
}

@media screen and (max-width: 768px) {
  .light-theme .viewport-medium-hidden { display: none; }
}

@media screen and (max-width: 1000px) {
  .light-theme .viewport-large-hidden { display: none; }
}

@media screen and (max-width: 1200px) {
  .light-theme .viewport-xl-hidden { display: none; }
}

.light-theme .viewport-small-shown { display: none; }

@media screen and (max-width: 600px) {
  .light-theme .viewport-small-shown { display: initial; }
