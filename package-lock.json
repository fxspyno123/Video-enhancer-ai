@media screen and (max-width: 960px) {
  .light-theme .viewport-trigger-panel-overlay-shown { display: initial; }
}

.dark-theme .viewport-medium-shown, .dark-theme .viewport-trigger-panel-overlay-shown { display: none; }

@media screen and (max-width: 768px) {
  .dark-theme .viewport-medium-shown { display: initial; }
}

@media screen and (max-width: 960px) {
  .dark-theme .viewport-trigger-panel-overlay-shown { display: initial; }
}

.light-theme .viewport-large-shown { display: none; }

